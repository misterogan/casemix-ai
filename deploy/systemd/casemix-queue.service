# -> /etc/systemd/system/casemix-queue.service (pola sama dengan antrol-queue.service)
[Unit]
Description=Casemix AI Laravel Queue (pemeriksaan AI dan impor FTP)
After=network.target mysql.service

[Service]
User=oem
Group=www-data
UMask=0002
WorkingDirectory=/var/www/casemix-ai
ExecStart=/usr/bin/php8.4 -d memory_limit=512M artisan queue:work database --queue=ai,default --timeout=1800 --tries=1 --sleep=3 --max-time=3600
Restart=always
RestartSec=5s
TimeoutStopSec=1850

[Install]
WantedBy=multi-user.target
