# ===== Tambahkan ke .env Laravel =====
APP_NAME="Casemix AI"
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casemix_ai
DB_USERNAME=casemix
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CASEMIX_APP_NAME="Casemix AI"
CASEMIX_HOSPITAL_NAME="RS Contoh"
CASEMIX_STORAGE_DISK=local
CASEMIX_UPLOAD_MAX_KB=20480
CASEMIX_AI_QUEUE=ai
CASEMIX_AI_MAX_IMAGES=16
CASEMIX_AI_MAX_PAGES=4
PDFTOPPM_BINARY=/usr/bin/pdftoppm

# Akun admin pertama (dipakai saat db:seed, lalu hapus dari .env)
CASEMIX_ADMIN_EMAIL=admin@rs.local
CASEMIX_ADMIN_PASSWORD=

# FTP SIMRS — isi di server, JANGAN commit ke Git
SIMRS_FTP_HOST=
SIMRS_FTP_PORT=21
SIMRS_FTP_USERNAME=
SIMRS_FTP_PASSWORD=
SIMRS_FTP_SSL=false
SIMRS_FTP_PASSIVE=true
SIMRS_FTP_TIMEOUT=30
SIMRS_FTP_PATH=/ftp/data/
SIMRS_FTP_PATH_RIWAYAT=/ftp/riwayat_pasien/
SIMRS_FTP_MAX_FILES=60
